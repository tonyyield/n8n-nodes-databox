{
  "name": "n8n-nodes-databox",
  "version": "0.1.0",
  "description": "n8n community node for Databox: push records to datasets in confirmed batches, and create and list datasets.",
  "license": "MIT",
  "homepage": "https://github.com/tonyyield/n8n-nodes-databox#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "databox",
    "analytics",
    "dashboards"
  ],
  "author": {
    "name": "Yield-AI Ltd",
    "email": "dev@yield-ai.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyyield/n8n-nodes-databox.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DataboxApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Databox/Databox.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
